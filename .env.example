# Shared environment for BrowserPilot. Copy to .env and fill in.
# Everything product-shaped — target sites, session caps, timeouts — lives in
# the database and is edited in the console. Only bootstrap secrets belong here.

# Postgres. In development this points at the Dokploy instance's external port;
# in production, at the internal service name on the Dokploy network.
DATABASE_URL=postgresql://browserpilot:password@host:5433/browserpilot

# Seals per-site signing secrets at rest (AES-256-GCM), minimum 32 characters.
# Losing it makes every stored site secret unrecoverable; changing it
# invalidates them all. Generate with:
#   head -c 48 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 44
BP_MASTER_KEY=

# Signs the short-lived WebSocket tickets the console mints for the runtime.
# Both services must be given the same value.
BP_TICKET_SECRET=

# Agent credential — set exactly one. The OAuth token comes from
# `claude setup-token` and bills against a Claude subscription; the API key
# bills per token and is the right choice for anything beyond personal use.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Speech to text (Groq Whisper, en/hi/gu).
GROQ_API_KEY=

# Service locations
BP_PORT=8787
WEB_PORT=3000
BP_RUNTIME_URL=http://localhost:8787
BP_WEB_URL=http://localhost:3000

# Node binary for the Playwright MCP server. The default `node` works in Docker
# and most Linux hosts; set it explicitly on WSL, where a bare `node` can
# resolve to the Windows build and fail on Linux paths.
BP_NODE_BIN=node
BP_DOWNLOADS_DIR=./downloads
