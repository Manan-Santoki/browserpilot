# Shared environment for BrowserPilot. Copy to .env and fill in.
# Everything product-shaped — target sites, session caps, timeouts — lives in
# the database and is edited in the console. Only bootstrap secrets belong here.

# Postgres. In development this points at the Dokploy instance's external port;
# in production, at the internal service name on the Dokploy network.
DATABASE_URL=postgresql://browserpilot:password@host:5433/browserpilot

# Seals per-site signing secrets at rest (AES-256-GCM), minimum 32 characters.
# Losing it makes every stored site secret unrecoverable; changing it
# invalidates them all. Generate with:
#   head -c 48 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 44
BP_MASTER_KEY=

# Signs the short-lived WebSocket tickets the console mints for the runtime.
# Both services must be given the same value.
BP_TICKET_SECRET=

# ── Model provider ───────────────────────────────────────────────────────────
# The agent talks to one Messages API. By default that is Anthropic's; set
# BP_ANTHROPIC_BASE_URL to route it through an Anthropic-compatible gateway
# instead. Verify any change with `bun run check:provider` before relying on it.
#
# Credential — set exactly one, and match it to the provider:
#   CLAUDE_CODE_OAUTH_TOKEN  `claude setup-token`. Bills a Claude subscription
#                            and authenticates to Anthropic only. Note that
#                            Anthropic does not permit reselling subscription
#                            rate limits to a product's own users, so this is
#                            for personal use — an API key is the multi-user
#                            answer.
#   ANTHROPIC_API_KEY        Sent as `x-api-key`.
#   ANTHROPIC_AUTH_TOKEN     Sent as `Authorization: Bearer`.
#
# For a gateway, the variable you choose IS the header the key is sent in, and
# gateways disagree about which they want — so pick by header, not by name.
# OpenCode wants `x-api-key`, i.e. ANTHROPIC_API_KEY, despite issuing an `sk-`
# key that reads like a bearer token. If a gateway returns 401 with a key you
# believe is correct, move it to the other variable; `check:provider` says
# which header it used and which to try instead.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Gateway base URL. Omit for Anthropic. Give the base only — the SDK appends
# `/v1/messages` itself, so the documented endpoint is trimmed back to this
# (pasting the full endpoint is fine; it is normalized).
#
#   OpenCode Go:   https://opencode.ai/zen/go    (key in ANTHROPIC_API_KEY)
#   OpenCode Zen:  https://opencode.ai/zen       (key in ANTHROPIC_API_KEY)
#   LiteLLM:       http://127.0.0.1:4000
# BP_ANTHROPIC_BASE_URL=

# Models the console may offer, as `id` or `id=Label`, comma separated. Both
# the runtime and the console read this, so the picker cannot drift from what
# the provider actually serves. Unset means the Claude family; with a gateway
# it is required, because Claude model ids are not valid there.
#
# Only some of a gateway's models reach an Anthropic-compatible endpoint —
# OpenCode routes Qwen and MiniMax there, and Grok/MiMo/Kimi/DeepSeek/GLM/GPT
# to OpenAI-shaped endpoints. The `sdk` agent engine below speaks both; the
# default `agent-sdk` engine speaks only the first.
# Quote it: labels contain spaces, and scripts/dev.sh sources this file through
# bash, which would otherwise try to run the second word as a command.
# BP_MODELS="qwen3.7-plus=Qwen 3.7 Plus,minimax-m3=MiniMax M3"

# Model used before an admin picks one in the console. Defaults to the first
# entry in BP_MODELS, so it usually needs no value of its own.
# BP_MODEL=

# Which agent loop runs a session.
#
#   agent-sdk  the Claude Agent SDK. Anthropic-format providers only. Default.
#   sdk        our own loop on the Vercel AI SDK. Speaks both formats, so it
#              reaches Grok, MiMo, Kimi and the rest — and carries screenshots
#              to them, which a naive bridge between the two formats drops.
#
# Both implement the same interface, so switching is one variable and a
# restart. Verify with: bun run check:engine <model>
# BP_AGENT_ENGINE=sdk

# Speech to text (Groq Whisper, en/hi/gu).
GROQ_API_KEY=

# Gemini Live voice control. The permanent key stays in the web service and
# mints one-use, constrained tokens for authenticated desktop/mobile clients.
GEMINI_API_KEY=
GEMINI_LIVE_ENABLED=true
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Store transcripts regardless; include their full text in server logs only
# when actively diagnosing Live Voice.
LIVE_VOICE_LOG_TRANSCRIPTS=false

# Service locations
BP_PORT=8787
WEB_PORT=3000
BP_RUNTIME_URL=http://localhost:8787
BP_WEB_URL=http://localhost:3000

# Node binary for the Playwright MCP server. The default `node` works in Docker
# and most Linux hosts; set it explicitly on WSL, where a bare `node` can
# resolve to the Windows build and fail on Linux paths.
BP_NODE_BIN=node
BP_DOWNLOADS_DIR=./downloads
