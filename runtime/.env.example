# URL of the JWM ERP deployment the robot will drive
BP_JWM_URL=https://jwm.example.com
# MUST match the SESSION_SECRET of that JWM deployment (used to mint the robot's cookie)
SESSION_SECRET=change-me

# Exactly one of these:
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# The JWM user the robot acts as (Phase 1 has no pairing yet).
# BP_DEBUG_USER_ID must be that user's UUID from the JWM database.
BP_DEBUG_USER_ID=
BP_DEBUG_USER_EMAIL=
BP_DEBUG_USER_NAME=Robot Operator
BP_DEBUG_USER_ROLE=admin

# Node binary used to run the Playwright MCP server. The default works in
# Docker and on most Linux hosts. Set it explicitly on WSL, where a bare `node`
# or `npx` can resolve to the Windows build and fail on Linux paths.
# BP_NODE_BIN=/usr/bin/node

# Optional overrides
BP_PORT=8787
BP_MODEL=claude-opus-5
BP_MAX_SESSIONS=2
BP_IDLE_TIMEOUT_MS=600000
BP_HARD_CAP_MS=3600000
BP_DOWNLOADS_DIR=./downloads
