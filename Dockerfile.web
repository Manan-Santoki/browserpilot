FROM oven/bun:1.3 AS build
WORKDIR /app

# Install from the workspace root. Each package keeps its own node_modules —
# drizzle-orm resolves under db/, the crypto libraries under core/ — so the
# build stage needs the whole tree rather than a hand-picked subset of it.
COPY package.json bun.lock ./
COPY core/package.json ./core/
COPY db/package.json ./db/
COPY runtime/package.json ./runtime/
COPY web/package.json ./web/
RUN bun install --frozen-lockfile

COPY core ./core
COPY db ./db
COPY web ./web

ENV NEXT_TELEMETRY_DISABLED=1
RUN cd web && bun run build

FROM oven/bun:1.3 AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

COPY --from=build /app ./

WORKDIR /app/web
EXPOSE 3000
CMD ["bun", "run", "start", "-p", "3000"]
