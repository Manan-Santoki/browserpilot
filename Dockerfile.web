FROM oven/bun:1.3 AS base
WORKDIR /app

FROM base AS deps
COPY package.json bun.lock ./
COPY core/package.json ./core/
COPY db/package.json ./db/
COPY runtime/package.json ./runtime/
COPY web/package.json ./web/
RUN bun install --frozen-lockfile

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/web/node_modules ./web/node_modules
COPY package.json bun.lock ./
COPY core ./core
COPY db ./db
COPY web ./web

# Next needs a DATABASE_URL present at build time for type resolution, but must
# not connect: every page that touches the database is dynamic, so nothing is
# prerendered against it.
ENV NEXT_TELEMETRY_DISABLED=1
RUN cd web && bun run build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/web/node_modules ./web/node_modules
COPY --from=build /app/core ./core
COPY --from=build /app/db ./db
COPY --from=build /app/web ./web
COPY --from=build /app/package.json ./package.json

WORKDIR /app/web
EXPOSE 3000
CMD ["bun", "run", "start", "-p", "3000"]
