{
  "expo": {
    "name": "BrowserPilot",
    "slug": "browserpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "browserpilot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msantoki.browserpilot",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanning the pairing code shown in the BrowserPilot console is how this phone is linked to your account."
      }
    },
    "android": {
      "package": "com.msantoki.browserpilot",
      "adaptiveIcon": {
        "backgroundColor": "#0f1115"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scanning the pairing code shown in the BrowserPilot console is how this phone is linked to your account."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "iosMicrophonePermission": "Live Voice uses the microphone only while an active BrowserPilot session is open.",
          "androidPermissions": [
            "android.permission.INTERNET",
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.RECORD_AUDIO"
          ],
          "androidForegroundService": false,
          "androidFSTypes": []
        }
      ],
      "./plugins/with-browserpilot-network"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
