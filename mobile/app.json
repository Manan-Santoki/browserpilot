{
  "expo": {
    "name": "BrowserPilot",
    "slug": "browserpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "browserpilot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msantoki.browserpilot",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanning the pairing code shown in the BrowserPilot console is how this phone is linked to your account."
      }
    },
    "android": {
      "package": "com.msantoki.browserpilot",
      "adaptiveIcon": { "backgroundColor": "#0f1115" },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scanning the pairing code shown in the BrowserPilot console is how this phone is linked to your account."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
